# ==============================================================================
# Sedi Laka Center — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Runtime
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security Secrets (Change in Production!)
# ------------------------------------------------------------------------------
# High-entropy random hex or string for signing session cookies
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Secret key used to generate HMAC-SHA256 signatures for digital resource downloads
DOWNLOAD_TOKEN_SECRET=replace_with_a_secure_random_download_signing_key

# ------------------------------------------------------------------------------
# 3. Storage Directories (Optional - defaults to relative project paths)
# ------------------------------------------------------------------------------
# DATA_DIR=./data
# BACKUP_DIR=./backups
# RESOURCES_DIR=./protected_resources

# ------------------------------------------------------------------------------
# 4. Initial Administrator Seed Credentials
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@sedilaka.org
ADMIN_PASSWORD=SediLakaAdmin2026!

# ------------------------------------------------------------------------------
# 5. Payment Gateways
# Supported defaults: 'mock_sandbox', 'mpesa', 'card_stripe'
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER_DEFAULT=mock_sandbox

# Safaricom M-Pesa (Daraja API)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/webhook/mpesa

# Stripe Credit/Debit Card Gateway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 6. Outbound Email (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sedi Laka Center" <sedilaka.org@gmail.com>
